# ─── Swift+Save (non-interest savings pockets + Spend&Save) ──────────────────
# Deploy: pnpm contracts:deploy-swiftsave
# Apply SQL: packages/database/supabase/swift-save.sql
# NO yield / APY / interest — segregated savings only.
NEXT_PUBLIC_SWIFT_SAVE_VAULT_ADDRESS=
SUPABASE_SAVINGS_POCKETS_TABLE=savings_pockets
SUPABASE_SAVINGS_TRANSACTIONS_TABLE=savings_transactions

# ─── Traction Analytics ─────────────────────────────────────────────────────
