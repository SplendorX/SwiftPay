# ─── SwiftPay Earn (Aave USDC vault) ─────────────────────────────────────────
# Deploy: pnpm --filter @swiftpay/contracts deploy:earn
# Testnet without official Aave → MockAavePool (simulation). Never claim real yield.
# Mainnet switch: set live addresses from official docs only — never invent them.
EARN_NETWORK=arcTestnet
EARN_VAULT_OWNER=
EARN_FEE_RECIPIENT=
EARN_FORCE_SIMULATION=
# Official Aave addresses when live on Arc (leave empty until verified):
AAVE_POOL_ADDRESS_TESTNET=
AAVE_ATOKEN_USDC_TESTNET=
AAVE_POOL_ADDRESS_MAINNET=
AAVE_ATOKEN_USDC_MAINNET=
ARC_MAINNET_CHAIN_ID=
ARC_MAINNET_RPC_URL=
ARC_MAINNET_USDC=
ARC_MAINNET_EXPLORER=
# Frontend (copy from deploy output):
